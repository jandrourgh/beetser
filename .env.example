# Deployment configuration (environment variables)

# Docker Compose variables
PUID=1000
PGID=1000
TZ=Europe/Madrid
BEETSER_CONFIG_PATH=./config
# Image pulled by docker compose (ghcr.io/jandrourgh/beetser).
# `latest`, a release version such as 0.1.0, or sha-<commit>.
BEETSER_IMAGE_TAG=latest
# Default single parent mount (contains all origins/destinations):
BEETSER_MEDIA_PATH=./media
# Optional: used by docker-compose.multi-media.yml. Set one path per service:
# BEETSER_MEDIA_1=/mnt/tank/media/soulseek
# BEETSER_MEDIA_2=/mnt/tank/media/downloads
# BEETSER_MEDIA_3=/mnt/tank/media/incoming
# BEETSER_MUSIC_PATH=/mnt/tank/music
BEETSER_PASSWORD=change-me

# Directory for the beets library database, Beetser state and generated configs.
BEETSER_DATA_DIR=/config

# Central beets library database. Defaults to ${BEETSER_DATA_DIR}/library.db
# BEETSER_LIBRARY_DB=/config/library.db

# Where the built frontend lives (the container sets this for you).
BEETSER_STATIC_DIR=static

# HTTP listener.
BEETSER_HOST=0.0.0.0
BEETSER_PORT=8080

# Authentication. Either set a plain password or a pre-computed hash.
BEETSER_PASSWORD=
# BEETSER_PASSWORD_HASH=

# Session cookie signing key. Generated and persisted in the data dir if unset.
# BEETSER_SECRET_KEY=

# Mark cookies Secure when served over HTTPS (also detected from X-Forwarded-Proto).
BEETSER_SECURE_COOKIES=false

# Worker tuning (all optional).
BEETSER_LOG_LEVEL=INFO
BEETSER_SCAN_INTERVAL=300
BEETSER_IMPORT_TIMEOUT=900

# Container user mapping (docker entrypoint only).
PUID=1000
PGID=1000
TZ=Etc/UTC
